---
import { Image } from 'astro:assets';
import ASICViewer from '../common/ASICViewer.astro';
import ModelViewer from './ModelViewer';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
// Alternate sides: even index → model left, odd index → model right
const modelRight = index % 2 === 1;
const number = String(index + 1).padStart(2, '0');
---

<article class="row" data-model-right={modelRight ? '' : undefined}>
  <div class="row-media">
    {
      project.media === 'asic' ? (
        <ASICViewer loading="lazy" label={`Interactive 3D view of ${project.name}`} />
      ) : project.media === 'obj' && project.modelUrl ? (
        <ModelViewer
          client:visible
          src={project.modelUrl}
          label={`Interactive 3D model of ${project.name}`}
        />
      ) : project.media === 'image' && project.image ? (
        <div class="project-image-box">
          <Image
            src={project.image}
            alt={project.name}
            class:list={[
              'project-image',
              { 'project-image--shift-down': project.slug === 'muxbox' },
            ]}
            widths={[330, 445, 660, 890]}
            sizes="(min-width: 820px) 445px, 90vw"
            loading="lazy"
          />
        </div>
      ) : (
        <div class="model-placeholder" role="img" aria-label={`3D model of ${project.name} (coming soon)`}>
          <span class="model-label">3D model</span>
          <span class="model-sub">coming soon</span>
        </div>
      )
    }
  </div>

  <div class="row-text">
    <span class="row-number eyebrow">{number}</span>
    <h3 class="row-name">{project.name}</h3>
    <p class="row-desc">{project.description}</p>
    {project.result && <p class="row-result">{project.result}</p>}
    <a class="row-more" href={project.href}>
      See details
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6"
          stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .row + :global(.row) {
    margin-top: var(--section-spacing);
  }

  /* Media sits in column 1 by default; move it to column 2 for odd rows */
  .row-media {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }
  .row-text {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }
  .row[data-model-right] .row-media {
    grid-column: 2;
  }
  .row[data-model-right] .row-text {
    grid-column: 1;
  }

  /* Still photo, framed to match the ASIC / model viewers */
  .project-image-box {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-black);
    border: 1px solid color-mix(in srgb, var(--color-sky) 35%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-blue) 25%, transparent),
      0 30px 80px -40px var(--color-blue);
  }

  .project-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Slight zoom + downward shift so the crop sits lower (muxbox) */
  .project-image--shift-down {
    transform: scale(1.12) translateY(4%);
  }

  .model-placeholder {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background:
      radial-gradient(
        120% 120% at 50% 0%,
        color-mix(in srgb, var(--color-blue) 22%, var(--color-black)) 0%,
        var(--color-black) 60%
      );
    border: 1px dashed color-mix(in srgb, var(--color-sky) 35%, transparent);
  }

  .model-label {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-sky);
  }
  .model-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-white) 45%, transparent);
  }

  .row-number {
    display: block;
    color: color-mix(in srgb, var(--color-gold) 85%, transparent);
    margin-bottom: 14px;
  }

  .row-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-white);
  }

  .row-desc {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-white) 82%, transparent);
    margin: 18px 0 0;
    max-width: 46ch;
  }

  /* Result / award — gold, mirroring the green highlight on the original site */
  .row-result {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-gold);
    margin: 16px 0 0;
    max-width: 46ch;
  }

  .row-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    padding: 11px 22px;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--color-white);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-sky) 45%, transparent);
    border-radius: var(--radius-pill);
    transition:
      color var(--duration) ease,
      border-color var(--duration) ease,
      background-color var(--duration) ease;
  }

  .row-more svg {
    transition: transform var(--duration) ease;
  }

  .row-more:hover {
    color: var(--color-black);
    background-color: var(--color-sky);
    border-color: var(--color-sky);
  }

  .row-more:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    /* On mobile every row stacks media above text, regardless of parity */
    .row-media,
    .row[data-model-right] .row-media {
      grid-column: 1;
      grid-row: 1;
    }
    .row-text,
    .row[data-model-right] .row-text {
      grid-column: 1;
      grid-row: 2;
    }
    .model-placeholder {
      max-width: 480px;
    }
  }
</style>
