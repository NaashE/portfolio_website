---
import { site } from '../../data/site';
---

<footer class="footer">
  <div class="container footer-inner">
    <span class="footer-copy">{site.copyright}</span>
    <nav class="footer-links" aria-label="Social and contact">
      <a class="footer-link" href={site.linkedin} target="_blank" rel="noopener">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
          <path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.4h3.06V21H3.4V8.4Zm5.08 0h2.93v1.72h.04c.41-.77 1.4-1.58 2.89-1.58 3.09 0 3.66 2.03 3.66 4.68V21h-3.05v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94V21H8.48V8.4Z"/>
        </svg>
        LinkedIn
      </a>
      <a class="footer-link" href={`mailto:${site.email}`}>{site.email}</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid color-mix(in srgb, var(--color-sky) 14%, transparent);
    margin-top: var(--section-spacing);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 80px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: color-mix(in srgb, var(--color-white) 65%, transparent);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 28px);
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-sky);
    text-decoration: none;
    transition: color var(--duration) ease;
  }

  .footer-link:hover {
    color: var(--color-gold);
  }

  .footer-icon {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 480px) {
    .footer-inner {
      flex-direction: column;
      justify-content: center;
      gap: 10px;
      text-align: center;
    }

    .footer-links {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
